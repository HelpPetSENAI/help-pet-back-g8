# ============================================================
# HelpPet Service - Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no Git
# ============================================================

SPRING_APPLICATION_NAME=help-pet-service
SERVER_PORT=8081

# Banco de Dados MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/helppet?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=SUA_SENHA_AQUI

# JPA - NUNCA use 'update' ou 'create-drop' em producao
SPRING_JPA_DDL_AUTO=update

# JWT - DEVE ser o MESMO segredo do Gateway
# Gere com: openssl rand -hex 64
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_SEGURA_DE_MINIMO_64_CARACTERES_AQUI
JWT_EXPIRATION=86400000

# Token interno entre servicos - DEVE ser o MESMO do Gateway
INTERNAL_SERVICE_TOKEN=SUBSTITUA_POR_TOKEN_INTERNO_SEGURO

# Pool de conexoes
DB_POOL_SIZE=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
